# ===========================================================================
# 数据库实例管理系统 —— 环境变量示例
# ===========================================================================
#
# 用法：复制为 .env 后按需修改。启动器（start.bat / launcher.py）首次运行
# 会自动生成一份可用的 .env，一般不需要手工创建。
#
# 约定：
# - 值为空 = 使用代码里的默认值（下面每项都标了"默认"）。
# - 布尔值只认 True / False（大小写不敏感）。
# - 改完必须重启服务才生效。

# ---- Django ---------------------------------------------------------------
# 会话签名密钥。少于 50 字符、或用 change-me 之类的占位符，服务会**拒绝启动**。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(64))"
# 说明：启动器发现占位符会自动替换并提示；手工改过这里会让已登录会话失效。
DJANGO_SECRET_KEY=change-me-in-production-please-use-50-chars-or-more

# 调试开关。默认 False —— 生产绝不要打开：报错页会吐出源码片段、SQL 与配置。
# 只有本地开发排错时临时置 True。
DJANGO_DEBUG=False

# 允许访问的主机名（逗号分隔）。内网部署要把本机 IP 或域名加进来，
# 否则浏览器会看到 "DisallowedHost"。默认 127.0.0.1,localhost
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 监听地址。默认 127.0.0.1（只有本机能访问）。
# 要让同事从其它机器打开界面，改成 0.0.0.0（所有网卡）或本机内网 IP，
# 并把该地址/域名同步加进上面的 DJANGO_ALLOWED_HOSTS。
# 注意：本系统保存着全部生产库的密码（加密存储），对谁开放请自行斟酌；
# 改成非回环地址后，请务必先修改默认管理员口令。
APP_BIND_HOST=127.0.0.1

# ---- 敏感字段加密密钥（必填，缺失则启动失败）------------------------------
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ！！！这一项丢了，所有已保存的数据库密码就永久无法恢复 ！！！
# .env 已被 gitignore，请另外做一次离线备份（U 盘 / 密码管理器 / 纸质封存）。
# 轮换此密钥不会自动重新加密旧数据，需要按 README 的迁移步骤操作。
FIELD_ENCRYPTION_KEY=

# ---- 数据库（系统自身的库）------------------------------------------------
# sqlite（默认，开箱即用，无需安装任何东西） / postgresql
DB_ENGINE=sqlite

# 仅 DB_ENGINE=postgresql 时生效。
DATABASE_URL=postgres://user:password@127.0.0.1:5432/db_manager

# 数据库连接复用秒数。0 = 每个请求新建连接（最保守，也最慢）。
DB_CONN_MAX_AGE=60

# --- 仅 SQLite 生效 ---
# 写入锁等待上限（毫秒）。并发写撞锁时最多等这么久，超时再重试。
DB_BUSY_TIMEOUT_MS=5000
# 日志模式。WAL 允许"读不阻塞写"，是 SQLite 并发稳定的前提；改回 delete 会明显变慢。
DB_JOURNAL_MODE=WAL
# 落盘策略。FULL 最安全但每次写都 fsync（慢）；NORMAL 配合 WAL 已足够。
DB_SYNCHRONOUS=NORMAL

# ---- 调度模式 -------------------------------------------------------------
# auto      : 消息队列可达**且**有 celery worker 在消费时用 Celery，
#             否则自动降级为进程内调度（推荐，小白零配置）
#             注意：只探测到 Redis 还不够——Redis 起着但 worker 没起时，
#             若判定为 Celery，所有定时任务都会静默不执行。
# celery    : 强制 Celery，缺 Redis 时报错；须自行启动 worker 与 beat
# inprocess : 强制进程内调度，完全不依赖外部服务
SCHEDULER_MODE=auto

# ---- Celery ---------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# 任务结果后端（查看任务返回值用），可与 broker 用不同的 db 号隔离
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# 本地无 Redis 时置 True，任务在当前进程同步执行（仅适合调试）
CELERY_TASK_ALWAYS_EAGER=False

# ---- 登录与会话 -----------------------------------------------------------
# 同一账号连续失败多少次后临时锁定。默认 5
LOGIN_MAX_FAILURES=5
# 同一 IP 累计失败多少次后锁定。默认 20，故意比上面宽：
# 内网出口常共用 IP，若两者相同，同事输错几次会把整层楼锁在门外。
LOGIN_MAX_FAILURES_PER_IP=20
# 锁定时长（秒）。默认 900（15 分钟）
LOGIN_LOCKOUT_SECONDS=900

# 共享缓存地址。留空 = 进程内缓存（LocMemCache），只适合单进程启动方式
# （start.bat / launcher.py 的 waitress 单进程多线程）。
#
# 如果你改成 gunicorn 多 worker、或多个进程 + 负载均衡，**必须**填这里：
# 登录失败计数存在缓存里，各进程各算一份会让限流阈值等效放大 N 倍。
# 填 redis://... 即自动切换后端，不需要改代码。
CACHE_URL=

# 会话有效期（秒）。默认 43200（12 小时，覆盖一个班次）。
# 注意这是**固定**过期，不是"空闲 12 小时"。
SESSION_COOKIE_AGE=43200
# 每个请求都续期会话。默认 False —— 打开后所有只读请求都会写一次 session 表，
# 在 SQLite 上等于把读流量变成写流量。
SESSION_SAVE_EVERY_REQUEST=False
# 关闭浏览器即失效。默认 False（内网习惯让页面开着过夜）。
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# ---- HTTPS ----------------------------------------------------------------
# 默认 False：内网默认部署是 http://内网IP:8000。
# 置 True 表示"我在 TLS 后面"，会一并打开 Secure Cookie 与强制跳转 https。
# 若前面没有真正的 TLS 监听却打开它，页面会直接打不开。
HTTPS_ENABLED=False

# 反向代理（nginx / 公司网关）会改写 CDN 域名。走 https 且非默认端口时
# 必须显式列出，否则表单提交会被 CSRF 拦下（403）。
# 例：CSRF_TRUSTED_ORIGINS=https://db.example.com,https://10.0.0.5:8443
CSRF_TRUSTED_ORIGINS=

# HSTS 只在 HTTPS_ENABLED=True 时生效。
# 一旦下发就会被浏览器记住且**无法撤回**：先设 3600 试，确认长期只走 https
# 再逐步调大。默认 0（不下发）。
SECURE_HSTS_SECONDS=0
# 是否把 HSTS 策略同时套用到所有子域（仅在 SECURE_HSTS_SECONDS>0 时有意义）
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# preload 会把域名提交进浏览器内置列表，退出流程以月计，慎用
SECURE_HSTS_PRELOAD=False

# ---- 反向代理 -------------------------------------------------------------
# 是否采信 X-Forwarded-For / X-Forwarded-Proto。
# 默认 False：任何人都能手工加这个头伪造来源 IP，把审计日志变成假证据。
# 只有进程确实跑在 nginx 等代理后面时才置 True。
TRUST_PROXY_HEADERS=False

# ---- 业务参数 -------------------------------------------------------------
# 列表搜索策略。contains（默认，任意位置匹配，索引无效但符合直觉）
# / prefix（前缀匹配，能走索引，实例上万时明显更快）。
SEARCH_MODE=contains

# TCP 端口探测超时（秒），取值 1-5。默认 2
PROBE_TIMEOUT_SECONDS=2
# 探测失败后的重试次数上限。默认 3（共 3 次尝试，不是首次 + 3 次）
PROBE_MAX_ATTEMPTS=3
# 退避基数（毫秒），第 n 次重试等待 base * 2^(n-1)。默认 200
PROBE_BACKOFF_BASE_MS=200
# 单次探测的总时间预算（毫秒），超出即停止重试。默认 5000
PROBE_TOTAL_BUDGET_MS=5000

# 慢请求阈值（毫秒），超过则落库。默认 500
SLOW_REQUEST_MS=500

# ---- 密码轮换 -------------------------------------------------------------
# 生成密码长度。默认 32
PASSWORD_LENGTH=32
# 并发轮换线程数。默认 0 = 按后端自适应（SQLite 收敛，PostgreSQL 放开）
ROTATION_CONCURRENCY=0
# 每批处理的实例数。默认 100
ROTATION_BATCH_SIZE=100
# 改密后是否回连验证新密码真的生效。默认 True
# 关掉它会让"提示轮换成功、实际没生效"这类问题无法被发现。
ROTATION_VERIFY_AFTER_CHANGE=True

# ---- 目标库连接（控制台「执行 SQL」用）------------------------------------
# 连接超时（秒），取值 1-30。默认 5
DB_CONNECT_TIMEOUT_SECONDS=5
# 查询超时（秒），取值 1-300。默认 30，防止一条慢 SQL 挂死线程
DB_QUERY_TIMEOUT_SECONDS=30
# 单次查询最多取回多少行，取值 1-5000。默认 500，避免 SELECT * 打爆内存
DB_MAX_ROWS=500

# ---- 监控采集（apps.monitor）----------------------------------------------
# 是否启用目标库指标采集。默认 True
# 关掉后监控页面仍可打开并展示历史数据，只是不再产生新采样。
MONITOR_COLLECT_ENABLED=True
# 采集周期（分钟），取值 1-60。默认 1
# 下限是 1 分钟：进程内调度器按分钟去重，写 0 会导致永不触发。
MONITOR_INTERVAL_MINUTES=1
# 单个实例单次采集的超时（秒），取值 1-60。默认 5
# 这是每个查询的上限，不是整轮采集的总上限。
MONITOR_TIMEOUT_SECONDS=5
# 每轮采集的并发实例数，取值 1-32。默认 4
# 调高会让采集自身占用更多目标库连接，也可能加剧写锁争抢。
MONITOR_CONCURRENCY=4
# 指标与采集记录保留天数，取值 0-3650。默认 30；0 表示永久保留（不建议）
MONITOR_RETENTION_DAYS=30
# 单轮最多采集多少个实例，取值 0-10000。默认 0 表示不限
MONITOR_MAX_INSTANCES=0

# ---- 告警（apps.monitor）--------------------------------------------------
# 是否启用告警评估。默认 True
# 关掉后规则与历史事件都保留，只是不再产生新事件。
MONITOR_ALERT_ENABLED=True
# 告警评估周期（分钟），取值 1-60。默认 1
# 与采集同频即可，更频繁也没有新数据可评。
MONITOR_ALERT_INTERVAL_MINUTES=1
# 告警事件多久没再命中就自动恢复（分钟），取值 1-1440。默认 15
# 采集停掉时触发中的事件不会自己恢复，需要这个兜底。
MONITOR_ALERT_STALE_MINUTES=15
# 告警通知 webhook 地址，留空表示不通知
# 只推送"新触发"与"恢复"两类事件，不重复推送。
MONITOR_ALERT_WEBHOOK_URL=
# webhook 请求超时（秒），取值 1-30。默认 5
# 告警通知不该拖慢评估任务本身。
MONITOR_ALERT_WEBHOOK_TIMEOUT=5

# ---- SQL 洞察（apps.monitor）----------------------------------------------
# 是否随采集顺带抓取语句统计。默认 True
# 数据来自 MySQL performance_schema、PG pg_stat_statements、Redis commandstats。
# 关掉后洞察页仍可打开，只是不再新增指纹。
MONITOR_SQL_INSIGHT_ENABLED=True
# SQL 指纹保留天数，取值 0-3650。默认 90；0 表示永久保留
# 指纹按模板聚合而非按采样点增长，因此默认窗口比指标更长。
MONITOR_SQL_RETENTION_DAYS=90

# ---- 锁分析（apps.monitor）------------------------------------------------
# 是否采集锁等待与死锁。默认 True
# 只对 MySQL / PostgreSQL 生效；Redis 是单线程模型，不存在行锁等待。
MONITOR_LOCK_ENABLED=True
# 锁采集周期（分钟），取值 1-60。默认 5
# 锁查询要 join 多张性能视图，比指标查询贵，且锁等待是瞬时状态。
MONITOR_LOCK_INTERVAL_MINUTES=5

# ---- 日志保留（0 = 永久保留）----------------------------------------------
# 慢请求日志保留天数。默认 90
SLOW_LOG_RETENTION_DAYS=90
# 语句审计保留天数。默认 180
AUDIT_LOG_RETENTION_DAYS=180
# 密码轮换历史保留天数。默认 365
ROTATION_LOG_RETENTION_DAYS=365
# 清理任务每批删除条数。默认 500
LOG_CLEANUP_BATCH_SIZE=500
# 清理任务单表最多跑几批（防止一次删太多长时间占锁）。默认 200
LOG_CLEANUP_MAX_BATCHES=200

# ---- 慢请求落库方式 -------------------------------------------------------
# 是否异步批量写。默认 True：慢请求往往发生在数据库本身就慢的时候，
# 此时再同步 INSERT 会雪上加霜。
SLOW_LOG_ASYNC=True
# 队列容量，满了丢弃（宁可丢日志也不能拖垮请求）。默认 2000
SLOW_LOG_QUEUE_SIZE=2000
# 每批写入条数。默认 50
SLOW_LOG_BATCH_SIZE=50
# 攒批最长等待秒数。默认 5
SLOW_LOG_FLUSH_SECONDS=5
