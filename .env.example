# ---- Django ----
DJANGO_SECRET_KEY=change-me-in-production-please-use-50-chars-or-more
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---- 敏感字段加密密钥（必填，缺失则启动失败）----
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ---- 数据库 ----
# sqlite（默认，开箱即用） / postgresql
DB_ENGINE=sqlite
# 仅 DB_ENGINE=postgresql 时生效
DATABASE_URL=postgres://user:password@127.0.0.1:5432/db_manager
DB_CONN_MAX_AGE=60

# ---- Celery ----
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# 本地无 Redis 时置 True，任务同步执行
CELERY_TASK_ALWAYS_EAGER=False

# ---- 调度模式 ----
# auto      : 有 Redis 用 Celery Beat，没有则自动降级为进程内调度（推荐，小白零配置）
# celery    : 强制 Celery，缺 Redis 时报错
# inprocess : 强制进程内调度，完全不依赖外部服务
SCHEDULER_MODE=auto

# ---- 业务参数 ----
# TCP 探测超时（秒），取值 1-5
PROBE_TIMEOUT_SECONDS=2
# 慢请求阈值（毫秒），超过则落库
SLOW_REQUEST_MS=500
# 密码轮换长度
PASSWORD_LENGTH=32
